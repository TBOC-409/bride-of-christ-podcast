# The public Icecast listening address, including the mount name, over HTTPS.
# Example: https://radio.example.org/live
# Never put the Icecast source or admin password here, or anywhere on the site.
STREAM_URL="https://radio.example.org/live"

# Optional. Only needed when Icecast's status page is not at the usual
# /status-json.xsl on the stream's own server.
# STATUS_URL="https://radio.example.org/status-json.xsl"

# Public address of this site, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://bride-of-christ-podcast.onrender.com"
