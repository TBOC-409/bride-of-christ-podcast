# The public listening address for the radio, over HTTPS.
# On Zeno.fm this is the link under Stream Settings, for example
#   https://stream.zeno.fm/your-station-id
# It is NOT the encoder address under Encoder Settings (link.zeno.fm, port 80,
# mount .../source). That one is for the broadcasting software only.
# Never put the source or admin password here, or anywhere on the site.
STREAM_URL="https://stream.zeno.fm/your-station-id"

# Optional, self-hosted Icecast only: where its status JSON lives, if not at
# /status-json.xsl on the stream's own server.
# STATUS_URL="https://radio.example.org/status-json.xsl"

# Public address of this site, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://bride-of-christ-podcast.onrender.com"

# The church site, which the scrolling strip under the header is read from.
# Leave unset and the radio uses its own wording.
CHURCH_SITE_URL="https://bride-of-christ.onrender.com"

# The church YouTube channel, whose live broadcast the Watch button shows.
# Only needed if the channel ever changes.
# YOUTUBE_CHANNEL_ID="UC3Obzx39hxf4XXvhFkDfWlA"

# YouTube Data API key, used only to ask which broadcast is live right now.
# Without it the Watch button never appears. Create one at
# console.cloud.google.com > APIs & Services > Credentials (enable YouTube Data API v3).
YOUTUBE_API_KEY=""
