# The read-only database login created for this app, pooled connection (port
# 6543). Never the church app's owner login: this app must not be able to change
# the database it shares.
DATABASE_URL="postgresql://podcast_reader.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Public address of this site, no trailing slash. Used for the sitemap and for
# link previews when a session is shared.
NEXT_PUBLIC_SITE_URL="https://bride-of-christ-podcast.onrender.com"
